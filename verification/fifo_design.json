{
  "schema_version": "1.0",
  "design": {
    "name": "sync_fifo",
    "type": "synchronous_fifo",
    "rtl": "rtl/sync_fifo.sv",
    "parameters": {
      "DATA_WIDTH": 8,
      "DEPTH": 16
    }
  },
  "interface": {
    "clock": {"name": "clk", "edge": "posedge"},
    "reset": {
      "name": "rst_n",
      "active_level": 0,
      "asynchronous": true
    },
    "inputs": [
      {"name": "wr_en", "width": 1},
      {"name": "rd_en", "width": 1},
      {"name": "din", "width": "DATA_WIDTH"}
    ],
    "outputs": [
      {"name": "dout", "width": "DATA_WIDTH", "registered": true},
      {"name": "full", "width": 1},
      {"name": "empty", "width": 1},
      {"name": "count", "width": "ceil_log2(DEPTH+1)"}
    ]
  },
  "behavior": {
    "write_acceptance": "wr_en && !full_before_edge",
    "read_acceptance": "rd_en && !empty_before_edge",
    "write_when_full": "ignored",
    "read_when_empty": "ignored",
    "simultaneous_read_write": {
      "when_partially_occupied": "accept_both",
      "when_empty": "accept_write_only",
      "when_full": "accept_read_only"
    },
    "output_mode": "registered_on_accepted_read",
    "dout_holds_without_accepted_read": true,
    "pointer_wrap": "at_DEPTH_minus_1",
    "occupancy": "increment_on_write_only; decrement_on_read_only; unchanged_otherwise"
  },
  "verification": {
    "reference_model": "software_queue",
    "testbench": "tb/fifo_tb.sv",
    "scenarios": [
      "reset",
      "single_write_read",
      "fill_to_full",
      "write_while_full",
      "drain_to_empty",
      "read_while_empty",
      "simultaneous_read_write",
      "pointer_wraparound",
      "deterministic_stress"
    ],
    "checks": [
      "data_order",
      "no_data_loss",
      "no_data_duplication",
      "count_matches_queue",
      "empty_matches_zero_occupancy",
      "full_matches_depth_occupancy"
    ]
  },
  "extraction": {
    "source": "authored_baseline_design",
    "unresolved_items": [],
    "requires_review": true
  }
}
